!***********************************************************************
!  MIS41160 Optimisation in Business - Job Shop Scheduling
!  BASE MODEL  (Gueret, Prins & Sevaux 1999, Section 7.3)
!
!  Each job (wallpaper) visits the machines in a fixed order.
!  A machine can only work on one job at a time.
!  Goal: finish all jobs as early as possible (minimise the makespan).
!
!  Labels: [BASE] = unchanged from the book, [MOD] = book part we changed,
!          [NEW] = added by our team.
!  The model itself (variables, constraints, objective) is all [BASE].
!  [NEW] here: the ft06 benchmark data (D3) and the DATA switch, used to
!  test that the code reproduces a known optimum (55).
!
!  Run:   mosel exec Base_wallpaper_model.mos              (book case D1)
!         mosel exec Base_wallpaper_model.mos DATA=D3      (ft06 benchmark)
!***********************************************************************
model "Wallpaper job shop - base"
  uses "mmxprs"

  parameters
    DATA = "D1"          ! D1 = book case (3 x 3), D3 = ft06 (6 x 6)
  end-parameters

  ! --- size of the problem depends on the data set -------------------
  declarations
    NJ, NK: integer      ! number of jobs, max operations per job
  end-declarations

  if DATA = "D1" then
    NJ := 3; NK := 3
  else
    NJ := 6; NK := 6
  end-if

  declarations
    JOBS = 1..NJ
    OPS  = 1..NK
    MACH: array(JOBS,OPS) of string     ! machine used by operation k of job j
    DUR:  array(JOBS,OPS) of real       ! duration (0 = operation does not exist)
  end-declarations

  ! --- data: row j = route of job j ------------------------------------
  ! [BASE] D1 = book data (Blue, Green, Yellow printing machines)
  ! [NEW]  D3 = ft06 benchmark (Fisher & Thompson 1963)
  if DATA = "D1" then
    MACH:: ["Blue",   "Yellow", "",
            "Green",  "Blue",   "Yellow",
            "Yellow", "Blue",   "Green"]
    DUR::  [45, 10,  0,
            10, 20, 34,
            28, 12, 17]
  else
    MACH:: ["M3","M1","M2","M4","M6","M5",
            "M2","M3","M5","M6","M1","M4",
            "M3","M4","M6","M1","M2","M5",
            "M2","M1","M3","M4","M5","M6",
            "M3","M2","M5","M6","M1","M4",
            "M2","M4","M6","M1","M5","M3"]
    DUR::  [1, 3, 6, 7, 3, 6,
            8, 5,10,10,10, 4,
            5, 4, 8, 9, 1, 7,
            5, 5, 5, 3, 8, 9,
            9, 3, 5, 4, 3, 1,
            3, 3, 9,10, 4, 1]
  end-if

  ! [BASE] Big-M = sum of all durations (no schedule can be longer than this)
  BIGM := sum(j in JOBS, k in OPS) DUR(j,k)

  ! --- [BASE] decision variables ---------------------------------------
  declarations
    start: array(JOBS,OPS) of mpvar                     ! start time of each operation
    y: dynamic array(JOBS,OPS,JOBS,OPS) of mpvar        ! 1 if (j1,k1) goes before (j2,k2)
    Cmax: mpvar                                         ! makespan
  end-declarations

  ! --- [BASE] (P) route order: next operation starts after the previous one ends
  forall(j in JOBS, k in 1..NK-1 | DUR(j,k+1) > 0)
    start(j,k+1) >= start(j,k) + DUR(j,k)

  ! --- [BASE] (D) disjunctions: two operations on the same machine cannot overlap
  forall(j1 in JOBS, j2 in JOBS, k1 in OPS, k2 in OPS |
         j1 < j2 and DUR(j1,k1) > 0 and DUR(j2,k2) > 0 and MACH(j1,k1) = MACH(j2,k2)) do
    create(y(j1,k1,j2,k2))
    y(j1,k1,j2,k2) is_binary
    start(j2,k2) >= start(j1,k1) + DUR(j1,k1) - BIGM * (1 - y(j1,k1,j2,k2))
    start(j1,k1) >= start(j2,k2) + DUR(j2,k2) - BIGM * y(j1,k1,j2,k2)
  end-do

  ! --- [BASE] (C) makespan is at least the end of every operation ------
  forall(j in JOBS, k in OPS | DUR(j,k) > 0)
    Cmax >= start(j,k) + DUR(j,k)

  ! --- [BASE] solve: minimise the makespan -------------------------------
  minimise(Cmax)

  ! --- output ------------------------------------------------------------
  writeln("Data set ", DATA, ":  makespan = ", getobjval)
  writeln("Job  Op  Machine   Start    End")
  forall(j in JOBS, k in OPS | DUR(j,k) > 0)
    writeln(" J", j, "   ", k, "   ", strfmt(MACH(j,k), -7),
            strfmt(getsol(start(j,k)), 6), strfmt(getsol(start(j,k)) + DUR(j,k), 7))

end-model
