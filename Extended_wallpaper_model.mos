!  MIS41160 Optimisation in Business - Job Shop Scheduling (Team Id : 21)
!  EXTENDED MODEL: commercial wallcovering plant, 8 jobs x 5 machines
!
!  Built on the book's base model and extended with:
!    [NEW] release dates       - a job cannot start before its order arrives
!    [MOD] setup times on M2   - cleaning time between jobs depends on order
!    [NEW] M4 maintenance      - M4 is unavailable from MAINT_S to MAINT_E
!    [NEW] due dates           - EUR penalty per minute late
!    [NEW] two-stage solve     - optimise PRIMARY, keep it at its best value,
!                                then optimise SECONDARY
!  Objectives: "makespan", "penalty" (total EUR) or "lmax" (worst lateness)
!
!  Run:  mosel exec Extended_wallpaper_model.mos
!        mosel exec Extended_wallpaper_model.mos PRIMARY=makespan SECONDARY=penalty
!        mosel exec Extended_wallpaper_model.mos PRIMARY=lmax SECONDARY=penalty
!  Scenarios:
!    A  no maintenance          USE_MAINT=false
!    B' maintenance moved       MAINT_S=240 MAINT_E=270
!    C  rush order J3           RUSH_JOB=3 RUSH_DUE=130
!    D  setups halved           SETUP_FACTOR=0.5
!***********************************************************************
model "Wallpaper job shop - extended"
  uses "mmxprs"

  parameters
    PRIMARY      = "penalty"   ! first objective
    SECONDARY    = "makespan"  ! second objective ("none" = skip stage 2)
    USE_MAINT    = true        ! include the M4 maintenance window?
    MAINT_S      = 100         ! maintenance start (minutes)
    MAINT_E      = 130         ! maintenance end
    SETUP_FACTOR = 1.0         ! multiply all setup times
    RUSH_JOB     = 0           ! job with a new due date (0 = none)
    RUSH_DUE     = 0           ! the new due date
  end-parameters

  declarations
    JOBS = 1..8
    OPS  = 1..5
    MACH:  array(JOBS,OPS) of string    ! machine of operation k of job j
    DUR:   array(JOBS,OPS) of real      ! duration (0 = no such operation)
    REL:   array(JOBS) of real          ! release date
    DUE:   array(JOBS) of real          ! due date
    W:     array(JOBS) of real          ! EUR penalty per minute late
    SETUP: array(JOBS,JOBS) of real     ! setup on M2 when job j2 follows j1
  end-declarations

  !  data (D2) --
  !          route of each job (machine, duration)
  MACH:: ["M1","M2","M4","M5","",     ! J1 Royal Damask Gold
          "M1","M3","M2","M5","",     ! J2 Nordic Geometric Pastel
          "M2","M1","M3","M4","M5",   ! J3 Botanical Forest Mural
          "M1","M4","M2","M5","",     ! J4 Vintage Velvet Stripe
          "M3","M2","M4","M5","",     ! J5 Metallic Foil Abstract
          "M1","M2","M3","M5","",     ! J6 Kids Cartoon Playroom
          "M1","M4","M3","M5","",     ! J7 Textured Linen Neutral
          "M2","M4","M1","M5",""]     ! J8 Industrial Urban Concrete
  DUR::  [25, 30, 20, 15,  0,
          20, 25, 15, 20,  0,
          35, 20, 30, 25, 20,
          15, 35, 20, 25,  0,
          30, 25, 30, 15,  0,
          30, 20, 20, 15,  0,
          25, 20, 25, 20,  0,
          25, 30, 20, 25,  0]

  !       J1   J2   J3   J4   J5   J6   J7   J8
  REL:: [  0,  10,   0,  15,  20,   0,  25,  30]
  DUE:: [130, 130, 170, 170, 160, 150, 160, 190]
  W::   [ 35,  20,  50,  15,  40,  15,  25,  20]

  !         to: J1  J2  J3  J4  J5  J6  J7  J8
  SETUP:: [      0, 15,  5, 10,  8, 12, 10,  8,    ! from J1
                12,  0, 15,  8, 10,  6,  8, 12,    ! from J2
                 6, 18,  0, 12, 10, 14, 12,  6,    ! from J3
                10, 12, 10,  0,  8, 10,  6,  8,    ! from J4
                 8, 14,  8, 10,  0, 12, 10,  8,    ! from J5
                10,  8, 14,  8, 10,  0,  8, 10,    ! from J6
                 8, 10, 12,  6,  8,  8,  0,  8,    ! from J7
                 6, 14,  6, 10,  8, 12,  8,  0]    ! from J8

  ! scenario changes (data only, the model stays the same) 
  forall(j1 in JOBS, j2 in JOBS) SETUP(j1,j2) := SETUP(j1,j2) * SETUP_FACTOR
  if RUSH_JOB > 0 then
    DUE(RUSH_JOB) := RUSH_DUE
  end-if

  ! [MOD] Big-M: book uses the sum of durations; we add the latest release, the largest setup for every M2 operation, and the maintenance window
  BIGM := sum(j in JOBS, k in OPS) DUR(j,k) +
          max(j in JOBS) REL(j) +
          max(j1 in JOBS, j2 in JOBS) SETUP(j1,j2) * sum(j in JOBS, k in OPS | MACH(j,k) = "M2") 1 +
          (MAINT_E - MAINT_S)

  ! decision variables 
  declarations
    start: array(JOBS,OPS) of mpvar                   ! [BASE] start times
    y: dynamic array(JOBS,OPS,JOBS,OPS) of mpvar      ! [BASE] order on a machine
    z: dynamic array(JOBS,OPS) of mpvar               ! [NEW]  1 = after maintenance
    C: array(JOBS) of mpvar                           ! [NEW]  completion time
    T: array(JOBS) of mpvar                           ! [NEW]  tardiness (minutes late)
    Cmax: mpvar                                       ! [BASE] makespan
    Lmax: mpvar                                       ! [NEW]  largest lateness
    Makespan, Penalty, Lateness: linctr               ! the three objectives
    Obj1, Obj2: linctr
    FixObj1: linctr
  end-declarations

  Lmax is_free          ! lateness can be negative (job early)

  ! [BASE] route order
  forall(j in JOBS, k in 1..4 | DUR(j,k+1) > 0)
    start(j,k+1) >= start(j,k) + DUR(j,k)

  ! [NEW] release dates: first operation not before the order arrives 
  forall(j in JOBS)
    start(j,1) >= REL(j)

  ! [MOD] disjunctions, with setup time when the machine is M2 
  forall(j1 in JOBS, j2 in JOBS, k1 in OPS, k2 in OPS |
         j1 < j2 and DUR(j1,k1) > 0 and DUR(j2,k2) > 0 and MACH(j1,k1) = MACH(j2,k2)) do
    if MACH(j1,k1) = "M2" then
      S12 := SETUP(j1,j2)
      S21 := SETUP(j2,j1)
    else
      S12 := 0
      S21 := 0
    end-if
    create(y(j1,k1,j2,k2))
    y(j1,k1,j2,k2) is_binary
    start(j2,k2) >= start(j1,k1) + DUR(j1,k1) + S12 - BIGM * (1 - y(j1,k1,j2,k2))
    start(j1,k1) >= start(j2,k2) + DUR(j2,k2) + S21 - BIGM * y(j1,k1,j2,k2)
  end-do

  !  [NEW] M4 maintenance: finish before it starts OR start after it ends 
  if USE_MAINT then
    forall(j in JOBS, k in OPS | MACH(j,k) = "M4") do
      create(z(j,k))
      z(j,k) is_binary
      start(j,k) + DUR(j,k) <= MAINT_S + BIGM * z(j,k)
      start(j,k) >= MAINT_E - BIGM * (1 - z(j,k))
    end-do
  end-if

  !  [NEW] completion, tardiness, lateness; [BASE] makespan 
  forall(j in JOBS) do
    C(j) = sum(k in OPS | DUR(j,k) > 0 and (k = 5 or DUR(j,k+1) = 0)) (start(j,k) + DUR(j,k))
    Cmax >= C(j)
    T(j) >= C(j) - DUE(j)
    Lmax >= C(j) - DUE(j)
  end-do

  !  objectives 
  Makespan := Cmax
  Penalty  := sum(j in JOBS) W(j) * T(j)
  Lateness := Lmax

  if PRIMARY = "makespan" then Obj1 := Makespan
  elif PRIMARY = "lmax"   then Obj1 := Lateness
  else                         Obj1 := Penalty
  end-if

  if SECONDARY = "makespan" then Obj2 := Makespan
  elif SECONDARY = "lmax"   then Obj2 := Lateness
  else                           Obj2 := Penalty
  end-if

  !  stage 1: primary objective 
  minimise(Obj1)
  BEST := getobjval
  writeln("Stage 1: min ", PRIMARY, " = ", BEST)

  !  stage 2: secondary objective primary kept at its best value 
  if SECONDARY <> "none" then
    FixObj1 := Obj1 <= BEST + 0.0001
    minimise(Obj2)
    writeln("Stage 2: min ", SECONDARY, " = ", getobjval)
  end-if

  !  output 
  ! (solution values are rounded to whole minutes for printing)
  writeln 
  writeln("Makespan     = ", round(getsol(Cmax)), " min")
  writeln("Penalty      = EUR ", sum(j in JOBS) W(j) * maxlist(0, round(getsol(C(j))) - DUE(j)))
  writeln("Max lateness = ", round(getsol(Lmax)), " min")
  writeln
  writeln("Job  Release  Due  Finish  Late  Penalty")
  forall(j in JOBS) do
    FINISH := round(getsol(C(j)))
    LATE := maxlist(0, FINISH - DUE(j))
    writeln(" J", j, strfmt(REL(j), 8), strfmt(DUE(j), 6), strfmt(FINISH, 7),
            strfmt(LATE, 6), strfmt(LATE * W(j), 9))
  end-do
  writeln
  writeln("Schedule by machine (start - end)")
  forall(m in {"M1","M2","M3","M4","M5"}) do
    write(m, ":")
    forall(j in JOBS, k in OPS | MACH(j,k) = m)
      write("  J", j, " ", round(getsol(start(j,k))), "-", round(getsol(start(j,k)) + DUR(j,k)))
    writeln
  end-do

end-model
